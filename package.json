{
  "name": "operant",
  "version": "1.4.0",
  "description": "Hyprland-style tiling workspace for terminal AI agents: Claude Code, OpenAI Codex, OpenCode, Gemini CLI and more",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --check main.js && node --check updater.js && node --check media.js && node --check renderer/renderer.js && node --check renderer/settings.js && node --check renderer/themes.js && node --check shell-integration.js",
    "dist": "electron-builder --win msi --x64"
  },
  "author": {
    "name": "doolecg",
    "email": "doolecg@gmail.com"
  },
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "productName": "Operant",
  "repository": {
    "type": "git",
    "url": "https://github.com/doolecg/operant.git"
  },
  "homepage": "https://github.com/doolecg/operant",
  "build": {
    "appId": "com.doolecg.operant",
    "productName": "Operant",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "media.js",
      "media-helper.ps1",
      "renderer/**",
      "build/icon.png",
      "package.json",
      "shell-integration.js"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**",
      "media-helper.ps1",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "msi": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Operant",
      "artifactName": "Operant-${version}.msi"
    },
    "publish": null
  }
}
