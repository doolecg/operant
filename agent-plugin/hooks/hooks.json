{
  "description": "Operant's live context for agents in its tiles; does nothing outside Operant.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "operant hook session-start", "timeout": 8 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Bash|PowerShell|mcp__codegraph.*",
        "hooks": [
          { "type": "command", "command": "operant hook pre-tool-use", "timeout": 5 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "operant hook subagent-start", "timeout": 8 }
        ]
      }
    ]
  }
}
