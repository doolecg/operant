# Copy this file to .env and fill in what you need. Every line is optional.
# Dev (unpackaged): put .env in the repo root. Installed app: put it in the app data folder.
# Variables already set in the real environment always win over this file.
# Never commit .env; it is gitignored. This example holds placeholders only.

# Where Operant keeps its database and settings (default: the per-user app data folder).
OPERANT_DATA_DIR=

# Set to 1 to open the window behind other windows without taking focus.
OPERANT_BACKGROUND=

# Optional seed. On first run the token is moved into the encrypted store for the one Discord bot that has no
# token yet, and you can then delete it from this file. Bots are created in Settings > Discord; with no bot
# yet the value is ignored.
DISCORD_BOT_TOKEN=

# Optional seed for a Hindsight memory server hosted elsewhere. Used only while the Hindsight settings are
# still unset (the URL switches Hindsight to Remote; the key goes into the encrypted store).
HINDSIGHT_URL=
HINDSIGHT_API_KEY=

# Testing: set to 1 to run the updater from an unpackaged build.
OPERANT_UPDATE_TEST=
